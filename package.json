{
  "name": "cvcompiler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static, local-first CV editor with live A4 preview and print-to-PDF export.",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings src tests server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "e2e:pdf": "vite-node scripts/e2e-pdf.ts --"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "lucide-react": "1.59.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "oxlint": "1.16.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
